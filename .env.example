# Copy to .env for local development.
HOST=0.0.0.0
PORT=4000

# Postgres — matches docker-compose.yml
DATABASE_URL=postgres://kimana:kimana@localhost:5432/kimana

# Where the filesystem document store writes onboarding uploads
STORAGE_DIR=.storage

# Vite dev server origin, for CORS
CORS_ORIGIN=http://localhost:5173

# tracing filter
RUST_LOG=info,sqlx=warn

# Simulation knobs (optional)
KYB_CHECK_DELAY_MS=600
QUOTE_TTL_SECONDS=90
TRANSFER_AUTO_ADVANCE_MS=2500
TRANSFER_STEP_DELAY_MS=700
