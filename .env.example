# Copy to .env for local development.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Postgres — matches docker-compose.yml
DATABASE_URL=postgres://kimana:kimana@localhost:5432/kimana

# Where the filesystem DocumentStore writes onboarding uploads
STORAGE_DIR=.storage

# Vite dev server origin, for CORS
CORS_ORIGIN=http://localhost:5173

LOG_LEVEL=info
