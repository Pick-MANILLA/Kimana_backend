# Copy to .env for local development.
HOST=0.0.0.0
PORT=4000

# Postgres — matches docker-compose.yml
DATABASE_URL=postgres://kimana:kimana@localhost:5432/kimana

# Where the filesystem document store writes onboarding uploads
STORAGE_DIR=.storage

# Frontend origin(s) allowed to call this API, for CORS. Comma-separate to
# allow more than one (e.g. local dev + the deployed frontend at once):
#   CORS_ORIGIN=http://localhost:3000,https://kimana-frontend.vercel.app
CORS_ORIGIN=http://localhost:3000

# tracing filter
RUST_LOG=info,sqlx=warn

# Simulation knobs (optional)
KYB_CHECK_DELAY_MS=600
QUOTE_TTL_SECONDS=90
TRANSFER_AUTO_ADVANCE_MS=2500
TRANSFER_STEP_DELAY_MS=700

# Collections (issue #79). Each partner is off until configured.
#
# Yellow Card, NGN. The API secret also verifies its webhooks, so register
# <this API>/webhooks/yellowcard in the Yellow Card dashboard.
# YELLOWCARD_API_KEY=
# YELLOWCARD_API_SECRET=
# YELLOWCARD_BASE_URL=https://sandbox.api.yellowcard.io
# YELLOWCARD_CHANNEL_ID=        # pin the NG bank deposit channel (else looked up)
# YELLOWCARD_SOURCE_ACCOUNT=1111111111   # sandbox: this payer account completes
#
# Bridge, USD. The webhook public key is the PEM Bridge returns when you create
# the <this API>/webhooks/bridge endpoint; \n escapes are accepted.
# BRIDGE_API_KEY=
# BRIDGE_BASE_URL=https://api.sandbox.bridge.xyz/v0
# BRIDGE_WEBHOOK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# BRIDGE_DESTINATION_RAIL=base
# BRIDGE_DESTINATION_CURRENCY=usdc
# BRIDGE_DESTINATION_ADDRESS=   # defaults to SETTLEMENT_VAULT_ADDRESS

# On-chain settlement (optional; off when unset). The operator signer is not
# configured here: in production it is the custody provider's MPC wallet.
# SETTLEMENT_RPC_URL=http://127.0.0.1:8545
# SETTLEMENT_VAULT_ADDRESS=0x...
# With both set, the event listener runs and only confirmed vault events move a
# transfer from SETTLING onwards (the simulator stops there).
# SETTLEMENT_CONFIRMATIONS=3
# SETTLEMENT_POLL_MS=2000
# SETTLEMENT_START_BLOCK=0      # the vault's deployment block
# SETTLEMENT_LOG_RANGE=1000     # max blocks per eth_getLogs (RPC-capped)
#
# Kimana SettlementVault on Base Sepolia (chain 84532, USDC
# 0x036CbD53842c5426634e7929541eC2318f3dCF7e):
# SETTLEMENT_RPC_URL=https://sepolia.base.org
# SETTLEMENT_VAULT_ADDRESS=0x89c1EE7c7888154Fb82e868f36bA5Dd3d4D80Faf
# SETTLEMENT_START_BLOCK=47240140
#
# Shown on GET /settlement/balance (the USDC wallet); the network block needs
# SETTLEMENT_CHAIN_ID plus SETTLEMENT_VAULT_ADDRESS:
# SETTLEMENT_CHAIN_ID=84532
# SETTLEMENT_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# SETTLEMENT_EXPLORER_URL=https://sepolia.basescan.org
